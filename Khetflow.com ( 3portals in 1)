// Custom hook to handle those smooth number transitions on the stats
const useCountUp = (targetValue, duration = 3000) => {
  const [currentValue, setCurrentValue] = useState(0);

  useEffect(() => {
    let start = null;
    let frameId;

    const performAnimation = (now) => {
      if (!start) start = now;
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      
      // Using a custom quartic ease-out for a more "premium" feel
      const eased = 1 - Math.pow(1 - progress, 4);
      
      setCurrentValue(Math.floor(eased * targetValue));
      if (progress < 1) frameId = requestAnimationFrame(performAnimation);
    };

    frameId = requestAnimationFrame(performAnimation);
    return () => cancelAnimationFrame(frameId);
  }, [targetValue, duration]);

  return currentValue;
};

